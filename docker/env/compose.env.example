# Copy to docker/env/compose.env on the production host. This file has no secrets.
REGISTRY_IMAGE=ghcr.io/CHANGE_ME_ORGANIZATION/atlantia
APP_IMAGE_TAG=CHANGE_ME_IMMUTABLE_TAG
ATLANTIA_DOMAIN=atlantiasupermarket.com
ACME_EMAIL=operaciones@atlantiasupermarket.com
QUEUE_CRITICAL_NAMES=critical,checkout,payments,default
QUEUE_DEFAULT_NAMES=default,notifications,mail,ml,reports
MYSQL_BUFFER_POOL_SIZE=1G
MYSQL_MAX_CONNECTIONS=300
