# Atlantia - proveedores externos de produccion
# Copiar como /opt/atlantia/shared/integrations.env con permisos 600.
# Nunca guardar valores reales en Git.

# FEL INFILE
INFILE_MOCK=false
INFILE_BASE_URL=https://api.infile.com
INFILE_USERNAME=CHANGE_ME_INFILE_USER
INFILE_PASSWORD=CHANGE_ME_INFILE_PASSWORD
INFILE_WEBHOOK_SECRET=CHANGE_ME_RANDOM_MINIMUM_32_CHARACTERS

# Correo transaccional SMTP
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=CHANGE_ME_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_SMTP_USERNAME
ATLANTIA_MAIL_APP_PASSWORD=CHANGE_ME_SMTP_APP_PASSWORD
MAIL_TIMEOUT=10
MAIL_EHLO_DOMAIN=CHANGE_ME_PUBLIC_DOMAIN
MAIL_FROM_ADDRESS=CHANGE_ME_FROM_EMAIL
MAIL_FROM_NAME="${APP_NAME}"

# Almacenamiento S3 privado
FILESYSTEM_DISK=s3
PRIVATE_FILESYSTEM_DISK=s3
FILESYSTEM_THROW=true
FILESYSTEM_REPORT=true
AWS_ACCESS_KEY_ID=CHANGE_ME_S3_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_ME_S3_SECRET_KEY
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=CHANGE_ME_S3_BUCKET
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Usa true y deja las dos credenciales AWS vacias si el servidor tiene un rol IAM.
AWS_USE_INSTANCE_PROFILE=false

# Firebase Cloud Messaging
FIREBASE_ENABLED=true
FIREBASE_PROJECT_ID=CHANGE_ME_FIREBASE_PROJECT_ID
FIREBASE_SERVICE_ACCOUNT_EMAIL=CHANGE_ME_FIREBASE_SERVICE_ACCOUNT_EMAIL
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCHANGE_ME_FIREBASE_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# Mapbox para rutas/geocodificacion y Google Maps para Android/web
ATLANTIA_MAPBOX_TOKEN=pk.CHANGE_ME_RESTRICTED_MAPBOX_TOKEN
MAPBOX_BASE_URL=https://api.mapbox.com
GOOGLE_MAPS_API_KEY=CHANGE_ME_RESTRICTED_GOOGLE_MAPS_KEY
GOOGLE_MAPS_MAP_ID=
GOOGLE_MAPS_DEFAULT_LAT=15.73090000
GOOGLE_MAPS_DEFAULT_LNG=-88.59440000
GOOGLE_MAPS_DEFAULT_ZOOM=13

# Centro de soporte operativo
ATLANTIA_SUPPORT_EMAIL=CHANGE_ME_SUPPORT_EMAIL
ATLANTIA_SUPPORT_PHONE=CHANGE_ME_SUPPORT_PHONE
ATLANTIA_SUPPORT_EMERGENCY_PHONE=CHANGE_ME_EMERGENCY_PHONE
ATLANTIA_SUPPORT_WHATSAPP=CHANGE_ME_WHATSAPP_PHONE
ATLANTIA_SUPPORT_HOURS="Lunes a domingo, 6:00 a. m. - 10:00 p. m."
ATLANTIA_SUPPORT_CHANNELS=app,whatsapp,phone,emergency
ATLANTIA_SUPPORT_SLA_LOW_MINUTES=30
ATLANTIA_SUPPORT_SLA_NORMAL_MINUTES=10
ATLANTIA_SUPPORT_SLA_HIGH_MINUTES=5
ATLANTIA_SUPPORT_SLA_CRITICAL_MINUTES=2

# Cobro presencial con terminal POS
ATLANTIA_POS_ENABLED=true
ATLANTIA_POS_PROVIDER=CHANGE_ME_POS_PROVIDER
ATLANTIA_POS_SUPPORT_PHONE=CHANGE_ME_POS_SUPPORT_PHONE
ATLANTIA_POS_MERCHANT_ID=CHANGE_ME_POS_MERCHANT_ID
ATLANTIA_POS_TERMINAL_IDS=CHANGE_ME_POS_TERMINAL_ID
ATLANTIA_POS_CURRENCY=GTQ
ATLANTIA_POS_RECEIPT_REQUIRED=true
ATLANTIA_CASH_MAX_CHANGE_BILL=500

# Transferencias: mantener desactivadas hasta tener cuenta bancaria empresarial.
ATLANTIA_TRANSFER_ENABLED=false
ATLANTIA_TRANSFER_BANK_NAME=
ATLANTIA_TRANSFER_ACCOUNT_NAME=
ATLANTIA_TRANSFER_ACCOUNT_NUMBER=
ATLANTIA_TRANSFER_INSTRUCTIONS=
