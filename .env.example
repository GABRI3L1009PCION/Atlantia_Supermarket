# ============================================================================
# APP
# Configuracion general de la aplicacion Laravel
# ============================================================================
APP_NAME="Atlantia Delivery"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
TELESCOPE_ENABLED=false
APP_URL=http://localhost
APP_TIMEZONE=America/Guatemala
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_GT
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database
TRUSTED_PROXIES=

# Numero de rondas bcrypt para contrasenas
BCRYPT_ROUNDS=12

# ============================================================================
# LOGGING
# Canales y nivel de logs
# ============================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
ATLANTIA_LOG_STACK=daily,stderr
ATLANTIA_INCIDENT_CHANNELS=stderr
ATLANTIA_ALERTS_CHANNEL=incidents
ATLANTIA_ALERTS_COOLDOWN_MINUTES=15

# ============================================================================
# DATABASE
# Conexion a base de datos MySQL
# ============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=atlantia_supermarket
DB_USERNAME=atlantia_app
# Llenar con la contrasena local o del servidor
ATLANTIA_DB_PASSWORD=your-db-password-here

# ============================================================================
# SESSION
# Sesiones de usuario cifradas
# ============================================================================
SESSION_DRIVER=database
# SESSION_CONNECTION se deja sin definir para usar la conexion DB por defecto.
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ============================================================================
# CACHE
# Cache principal de la aplicacion
# ============================================================================
CACHE_STORE=redis
CACHE_PREFIX=

# ============================================================================
# QUEUE
# Cola principal para jobs asincronos
# ============================================================================
QUEUE_CONNECTION=database

# ============================================================================
# BROADCAST Y FILESYSTEM
# Configuraciones base del framework
# ============================================================================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PRIVATE_FILESYSTEM_DISK=local

# ============================================================================
# REDIS
# Sesiones, cache y colas
# ============================================================================
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_CONNECTION=cache
REDIS_QUEUE_CONNECTION=queue
MEMCACHED_HOST=127.0.0.1

# ============================================================================
# MAIL
# Servidor SMTP para correos transaccionales
# ============================================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
# Llenar con la contrasena de aplicacion del buzón SMTP
ATLANTIA_MAIL_APP_PASSWORD=your-mail-app-password-here
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=no-reply@atlantiasupermarket.com
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================================
# STORAGE S3 COMPATIBLE
# Archivos y multimedia
# ============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_USE_INSTANCE_PROFILE=false

# ============================================================================
# SERVICES - MAPS
# Claves publicas restringidas por dominio para mapas y geocodificacion web
# ============================================================================
ATLANTIA_MAPBOX_TOKEN=your-mapbox-public-token-here
MAPBOX_BASE_URL=https://api.mapbox.com
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=
GOOGLE_MAPS_DEFAULT_LAT=15.73090000
GOOGLE_MAPS_DEFAULT_LNG=-88.59440000
GOOGLE_MAPS_DEFAULT_ZOOM=13

# ============================================================================
# SERVICES - MEILISEARCH
# Motor de busqueda del catalogo
# ============================================================================
MEILISEARCH_HOST=
MEILISEARCH_KEY=
SCOUT_DRIVER=collection

# ============================================================================
# SERVICES - FEL INFILE
# Certificacion electronica de facturas Guatemala
# ============================================================================
INFILE_MOCK=true
INFILE_BASE_URL=https://sandbox.infile.com
INFILE_USERNAME=your-infile-user-here
INFILE_PASSWORD=your-infile-password-here
INFILE_WEBHOOK_SECRET=your-infile-webhook-secret-here

# ============================================================================
# PAYMENT - PASARELA GENERICA
# Contrato compatible para pasarela intercambiable
# ============================================================================
PAYMENT_GATEWAY_BASE_URL=https://payments.example.test
PAYMENT_GATEWAY_MERCHANT_ID=your-merchant-id-here
PAYMENT_GATEWAY_SECRET=your-payment-secret-here
PAYMENT_GATEWAY_WEBHOOK_SECRET=your-payment-webhook-secret-here

# ============================================================================
# PAYMENT - STRIPE
# Claves reales de cobro con tarjeta
# ============================================================================
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=gtq

# ============================================================================
# ML
# Microservicio de modelos y prediccion
# ============================================================================
ML_SERVICE_URL=
ML_SERVICE_TOKEN=
ML_WEBHOOK_SECRET=
ML_TIMEOUT_SECONDS=10

# ============================================================================
# WEBHOOKS ADICIONALES
# Integraciones externas
# ============================================================================
COURIER_WEBHOOK_SECRET=your-courier-webhook-secret-here

ATLANTIA_ENFORCE_2FA_ROLES=super_admin,admin,empleado,soporte,contabilidad_finanzas,supervisor_logistica
ATLANTIA_ACCESS_TOKEN_TTL_MINUTES=10080
ATLANTIA_REFRESH_TOKEN_TTL_DAYS=30
ATLANTIA_PERSONAL_ACCESS_TOKEN_TTL_DAYS=30
ATLANTIA_BACKUP_DIR=storage/app/backups
ATLANTIA_BACKUP_RETENTION_DAYS=14
ATLANTIA_BACKUP_S3_PREFIX=backups/marketplace
ATLANTIA_BACKUP_WARNING_HOURS=26
ATLANTIA_BACKUP_ERROR_HOURS=50
ATLANTIA_SCHEDULER_HEARTBEAT_KEY=atlantia:ops:scheduler-heartbeat
ATLANTIA_SCHEDULER_STALE_AFTER_MINUTES=3
ATLANTIA_QUEUE_FAILED_JOBS_WARNING=1
ATLANTIA_QUEUE_FAILED_JOBS_ERROR=10
ATLANTIA_STAGING_URL=https://staging.atlantiasupermarket.local
ATLANTIA_STATUS_PAGE_URL=
ATLANTIA_RUNBOOK_PATH=docs/observabilidad-incidentes.md

# Firebase Cloud Messaging para la app del repartidor
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# Cobros presenciales y soporte operativo
ATLANTIA_POS_ENABLED=true
ATLANTIA_POS_PROVIDER=POS_bancario
ATLANTIA_POS_SUPPORT_PHONE=+50255550181
ATLANTIA_POS_MERCHANT_ID=
ATLANTIA_POS_TERMINAL_IDS=
ATLANTIA_POS_CURRENCY=GTQ
ATLANTIA_POS_RECEIPT_REQUIRED=true
ATLANTIA_TRANSFER_ENABLED=false
ATLANTIA_TRANSFER_BANK_NAME=Banco Industrial
ATLANTIA_TRANSFER_ACCOUNT_NAME=Atlantia Supermarket, S.A.
ATLANTIA_TRANSFER_ACCOUNT_NUMBER=0000-000000-000
ATLANTIA_TRANSFER_INSTRUCTIONS="Realiza la transferencia al entregar y comparte el comprobante con el repartidor."
ATLANTIA_CASH_MAX_CHANGE_BILL=500
ATLANTIA_SUPPORT_EMAIL=
ATLANTIA_SUPPORT_PHONE=+50255550101
ATLANTIA_SUPPORT_EMERGENCY_PHONE=+50255550191
ATLANTIA_SUPPORT_WHATSAPP=+50255550121
ATLANTIA_SUPPORT_HOURS="Lunes a domingo, 6:00 a. m. - 10:00 p. m."
ATLANTIA_SUPPORT_CHANNELS=app,whatsapp,phone,emergency
ATLANTIA_SUPPORT_SLA_LOW_MINUTES=30
ATLANTIA_SUPPORT_SLA_NORMAL_MINUTES=10
ATLANTIA_SUPPORT_SLA_HIGH_MINUTES=5
ATLANTIA_SUPPORT_SLA_CRITICAL_MINUTES=2

# Despacho automatico de repartidores
DISPATCH_AUTO_ENABLED=true
DISPATCH_OFFER_TTL_SECONDS=90
DISPATCH_GPS_MAX_AGE_SECONDS=180
DISPATCH_GPS_MAX_ACCURACY_METERS=100
DISPATCH_MAX_PICKUP_DISTANCE_KM=20
DISPATCH_MAX_ACTIVE_DELIVERIES=1
DISPATCH_RETRY_COURIER_AFTER_MINUTES=15
DISPATCH_BATCH_SIZE=100
DISPATCH_DISTANCE_WEIGHT=10
DISPATCH_LOAD_WEIGHT=25
DISPATCH_RATING_WEIGHT=0.5
DISPATCH_COMPLETION_WEIGHT=0.02

# ============================================================================
# SECURITY - RECAPTCHA
# Proteccion contra fraude y bots
# ============================================================================
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MINIMUM_SCORE=0.6

# ============================================================================
# SUPER ADMIN
# Cuenta de arranque para gobierno total de plataforma
# ============================================================================
ATLANTIA_SUPER_ADMIN_ENABLED=true
ATLANTIA_SUPER_ADMIN_NAME="Super Administrador Atlantia"
ATLANTIA_SUPER_ADMIN_EMAIL=superadmin@example.com
ATLANTIA_SUPER_ADMIN_PASSWORD=change-this-super-admin-password
ATLANTIA_SUPER_ADMIN_PHONE=50200000000

# ============================================================================
# FRONTEND
# Variables expuestas a Vite
# ============================================================================
VITE_APP_NAME="${APP_NAME}"
