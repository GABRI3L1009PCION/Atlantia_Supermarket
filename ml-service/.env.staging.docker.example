APP_ENV=staging
APP_DEBUG=false
ML_SERVICE_TOKEN=CHANGE_ME
ML_WEBHOOK_SECRET=CHANGE_ME
MARKETPLACE_BASE_URL=http://nginx
# Debe coincidir con ML_SERVICE_TOKEN para autenticar callbacks hacia Laravel.
MARKETPLACE_TOKEN=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME@redis:6379/4
CELERY_RESULT_BACKEND=redis://:CHANGE_ME@redis:6379/5
MLFLOW_TRACKING_URI=file:/app/mlruns
DRIFT_THRESHOLD=0.25
CELERY_CONCURRENCY=2
