APP_NAME="Atlantia Supermarket"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=atlantia
DB_USERNAME=atlantia
ATLANTIA_DB_PASSWORD=your-local-db-password-here

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_CONNECTION=cache
REDIS_QUEUE_CONNECTION=queue

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_ENCRYPT=true

SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=your-local-meilisearch-key-here

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=your-local-minio-password-here
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=atlantia
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

ML_SERVICE_URL=http://ml-api:8000
ML_SERVICE_TOKEN=your-local-ml-service-token-here
ML_WEBHOOK_SECRET=your-local-ml-webhook-secret-here

ATLANTIA_MAPBOX_TOKEN=
INFILE_BASE_URL=https://sandbox.infile.com.gt/api
INFILE_MOCK=true
PAYMENT_GATEWAY_WEBHOOK_SECRET=your-local-payment-webhook-secret-here

ATLANTIA_CARD_PAYMENT_MODE=pos
RECURRENTE_SECRET_KEY=
RECURRENTE_WEBHOOK_SECRET=
RECURRENTE_CURRENCY=GTQ

# Mapas OpenStreetMap: en produccion usa un proveedor de teselas y un OSRM propio.
MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILES_ATTRIBUTION="&copy; OpenStreetMap"
MAP_ROUTING_URL=https://router.project-osrm.org

# Avisos por WhatsApp: log (simulado), meta (WhatsApp Cloud API) o null (apagado).
WHATSAPP_DRIVER=null
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Contacto de soporte: aparece en la tienda, en los pedidos, en el panel del repartidor y en los textos legales.
ATLANTIA_SUPPORT_EMAIL=soporte@atlantiasystems.com
ATLANTIA_SUPPORT_PHONE="+502 4724-0606"
ATLANTIA_SUPPORT_EMERGENCY_PHONE="+502 4724-0606"
ATLANTIA_SUPPORT_WHATSAPP=+50247240606

# Continuar con Google (console.cloud.google.com > Credenciales > ID de cliente OAuth).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/entrar/google/callback"

# Notificaciones push gratis. Genera las claves con: php artisan push:claves
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:soporte@tudominio.com

# Membresia de envio gratis para clientes (apagada: no se ofrece).
ATLANTIA_MEMBRESIA_ACTIVA=false
